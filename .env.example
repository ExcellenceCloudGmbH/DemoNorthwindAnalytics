# Copy to .env and fill in. `.env` is gitignored — it holds secrets.
#
# Keycloak / OIDC. `lex init --bootstrap` can fetch these for you when they
# are missing; otherwise create a development client in Excellence Cloud and
# copy the values here.
KEYCLOAK_URL=
KEYCLOAK_REALM=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_CLIENT_UUID=

# Signs session cookies. Set a stable, per-installation value: without one the
# framework falls back to a random per-process key and everyone is signed out
# on every restart.
DJANGO_SECRET_KEY=

# Leave false unless you are running a broker; the calculations in this
# project are small and run fine in-process.
CELERY_ACTIVE=False
